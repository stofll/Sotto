  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "setup:dev": "vite --config vite.setup.config.ts",
    "setup:build": "tsc && vite build --config vite.setup.config.ts",
    "setup:native": "cd setup && tauri dev",
    "setup:package": "node ../scripts/build-setup.mjs",
    "setup:check": "node check-bundle-size.mjs --setup",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "test:watch": "vitest",
    "tauri": "tauri",
    "i18n:check": "node check-i18n.mjs && node find-eager-t.mjs",
    "i18n:keys": "node check-i18n.mjs --keys",
    "bundle:check": "node check-bundle-size.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "marked": "^18.0.14",
