{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tray-popup",
  "description": "The Windows tray popup: quick recording, microphone and settings shortcuts.",
  "windows": [
    "tray-popup"
  ],
  "permissions": [
    "core:default",
    "allow-focus-main-window",
    "allow-get-config",
    "allow-get-runtime-status",
    "allow-hide-tray-popup",
    "allow-list-microphones",
    "allow-set-replacements-paused",
    "allow-start-recording",
    "allow-stop-recording"
  ]
}
