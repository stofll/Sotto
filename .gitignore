# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node.js / Tauri frontend ---
node_modules/
dist/
.vite/
*.local

# --- Rust / Tauri ---
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/src-tauri/.tauri-native/

# --- Local data and uploads ---
TTS2/uploads/

# --- User diagnostic recordings (not test fixtures) ---
desktop/src-tauri/logs/recordings/
desktop/src-tauri/recordings/

# --- A/B experiment artefacts ---
scripts/ab_*.json
scripts/ab_run.log

# --- Local agent / IDE settings ---
.claude/settings.local.json
.kilo/

# --- Local secrets and environment ---
.env
.env.*
!.env.example

# --- Local databases ---
*.db
*.sqlite
*.sqlite3
!desktop/src-tauri/tests/fixtures/**/*.db
!desktop/src-tauri/tests/fixtures/**/*.sqlite
!desktop/src-tauri/tests/fixtures/**/*.sqlite3

# --- Local package-manager caches ---
.pnpm-store/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
# Windows reserved device name accidentally created by `> nul` redirects
# from a POSIX shell (git-bash), where `nul` is a normal file, not a device.
nul

# --- Miscellaneous ---
*.log
*.pid
logs/

# --- Local drafts, outside the repository ---
# spike/ and tools/ were dropped from the public repository: one-off
# experiments, some of them left over from the Python stack. The directories may
# stay on a developer machine, but they do not come back into git.
spike/
tools/

# --- Git worktrees (feature isolation) ---
.worktrees/
worktrees/

# --- Agent scratch (per-task briefs/reports/diffs/ledgers) ---
.superpowers/
# --- Local Windows toolchain scripts (not for commit) ---
/scripts/*.bat

# cargo-mutants output: the run working directory, not a project artefact.
mutants.out/
mutants.out.old/

# A side effect of `cargo test --lib`: a test opens sqlite in the crate root.
desktop/src-tauri/sotto.db
