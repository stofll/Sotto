---
import { translationsFor } from '../i18n/context';

/**
 * Strings the client scripts need. Rendering them as JSON keeps the behaviour
 * modules locale-agnostic: they read this element instead of embedding English.
 */
const { t } = translationsFor(Astro.currentLocale);

const runtime = {
  downloadWindows: t.hero.downloadWindows,
  downloadMac: t.hero.downloadMac,
  modelCount: t.models.count,
  dialog: t.dialog,
  nav: { openMenu: t.nav.openMenu, closeMenu: t.nav.closeMenu },
};
---

<script id="runtime-strings" type="application/json" set:html={JSON.stringify(runtime)} is:inline />
