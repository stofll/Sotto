---
import Icon from './Icon.astro';
import { llmProviders } from '../data/product';
import { translationsFor } from '../i18n/context';

const { t } = translationsFor(Astro.currentLocale);
const f = t.features;
---

<section id="features" class="section container" data-screen-label="02 Features">
  <div class="section-head" data-reveal>
    <p class="section-label">{f.eyebrow}</p>
    <h2 class="section-title">{f.title}</h2>
  </div>

  <div class="feature-grid">
    <article class="card feature feature-lead" data-reveal>
      {/* Pressing a mode only changes the illustration; without JavaScript the
          toggle mode is shown and the switch stays hidden. */}
      <div class="feature-visual feature-modes" data-modes>
        <div class="segmented js-only" role="group" aria-label={f.modesLabel}>
          <button type="button" aria-pressed="true" data-mode="toggle">{f.toggle}</button>
          <button type="button" aria-pressed="false" data-mode="ptt">{f.pushToTalk}</button>
        </div>
        <div class="mode-demo" aria-hidden="true">
          <div class="mode-keys" data-mode-panel="toggle">
            <span class="mode-key"><Icon name="keyboard" size={16} /></span><span class="mode-line"></span><span class="mode-key"><Icon name="keyboard" size={16} /></span>
          </div>
          <div class="mode-keys" data-mode-panel="ptt" hidden>
            <span class="mode-hold"><Icon name="keyboard" size={16} /></span>
          </div>
        </div>
        <span class="mode-hint" data-mode-hint="toggle">{f.toggleHint}</span>
        <span class="mode-hint" data-mode-hint="ptt" hidden>{f.pushToTalkHint}</span>
      </div>
      <div class="feature-copy">
        <h3>{f.anywhere.title}</h3>
        <p>{f.anywhere.text}</p>
        <p>{f.live.text}</p>
        <p class="feature-offline">{f.offline.text}</p>
      </div>
    </article>

    <article class="feature feature-secondary" data-reveal>
      <div class="feature-visual feature-custom">
        <ul class="replacements mono">
          {f.replacements.map(([from, to]) => (
            <li><s>{from}</s><span aria-hidden="true">→</span><span>{to}</span></li>
          ))}
        </ul>
        <ul class="providers mono">
          {llmProviders.map((provider) => <li>{provider}</li>)}
        </ul>
      </div>
      <div class="feature-copy">
        <h3>{f.custom.title}</h3>
        <p>{f.custom.text}</p>
      </div>
    </article>

    <article class="feature feature-secondary" data-reveal="90">
      <div class="feature-visual feature-center" aria-hidden="true">
        <div class="file-job">
          <div class="file-job-name mono"><span>interview.m4a</span><span>12:40</span></div>
          <div class="file-job-track"><div class="file-job-progress"></div></div>
        </div>
      </div>
      <div class="feature-copy">
        <h3>{f.files.title}</h3>
        <p>{f.files.text}</p>
      </div>
    </article>

    <article class="feature feature-secondary" data-reveal="180">
      <ul class="feature-visual history-sample" aria-hidden="true">
        {f.historyRows.map(([time, text]) => <li><span class="mono">{time}</span><span>{text}</span></li>)}
      </ul>
      <div class="feature-copy">
        <h3>{f.history.title}</h3>
        <p>{f.history.text}</p>
      </div>
    </article>
  </div>
</section>
