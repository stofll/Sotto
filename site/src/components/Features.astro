---
import Icon from './Icon.astro';
import Overlay from './Overlay.astro';
import { audioExtensions, capabilities, capabilityModels, type CapabilityId } from '../data/capabilities';
import { defaultHotkey } from '../data/desktop-demo';
import { llmProviders, models } from '../data/product';
import type { IconName } from '../data/icons';
import wallSmall from '../assets/wallpaper/hills-1200.webp';
import wallLarge from '../assets/wallpaper/hills-2400.webp';
import { translationsFor } from '../i18n/context';

const { t } = translationsFor(Astro.currentLocale);
const f = t.features;
const icons: Record<CapabilityId, IconName> = { voice: 'mic', cleanup: 'text-check', models: 'cube', profile: 'sparkle', history: 'clock', file: 'file-audio' };
const sample = t.cleanup.sample.map((part) => (typeof part === 'string' ? { from: part, to: part } : { from: part[0], to: part[1], kind: part[2] }));
const picks = capabilityModels.map((name) => models.find((model) => model.name === name)!);
---

<section id="features" class="section container" data-screen-label="03 Features">
  <div class="section-head" data-reveal>
    <p class="section-label">{f.eyebrow}</p>
    <h2 class="section-title">{f.title}</h2>
  </div>

  {/* Each panel is complete without scripts: its name, its text and a window.
      The list beside them only switches between panels, so it waits for JS. */}
  <div class="caps" data-caps style={`--wall: image-set(url(${wallSmall.src}) 1x, url(${wallLarge.src}) 2x)`} data-reveal="80">
    <div class="caps-list js-only" role="tablist" aria-label={f.listLabel} aria-orientation="vertical">
      {capabilities.map((id, index) => (
        <button type="button" role="tab" id={`cap-tab-${id}`} aria-controls={`cap-${id}`}
          aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? undefined : '-1'}>
          <Icon name={icons[id]} size={18} />
          <b>{f.items[id].name}</b>
          <span class="caps-tab-text" aria-hidden="true">{f.items[id].text}</span>
        </button>
      ))}
    </div>

    <div class="caps-panels">
      {capabilities.map((id) => (
        <article class="caps-panel" id={`cap-${id}`} role="tabpanel" aria-labelledby={`cap-tab-${id}`} data-cap={id}>
          <div class="caps-copy">
            <h3>{f.items[id].name}</h3>
            <p>{f.items[id].text}</p>
          </div>

          {id === 'voice' && (
            <div class="caps-voice" aria-hidden="true">
              <div class="caps-keys">{defaultHotkey.map((key) => <kbd>{key}</kbd>)}</div>
              <Overlay draft={f.draft} count={f.draft.length} phase="stream" />
            </div>
          )}

          {id === 'cleanup' && (
            <div class="caps-window">
              <p class="caps-window-title">{t.cleanup.eyebrow}</p>
              <p class="caps-row caps-raw">{sample.map((part) => (part.kind && part.from ? <span class={`cl cl-${part.kind}`}>{part.from}</span> : part.from))}</p>
              <p class="caps-row">{sample.map((part) => (part.kind && part.to ? <span class={`cl cl-${part.kind}`}>{part.to}</span> : part.to))}</p>
              <ul class="pill-list">{Object.values(t.cleanup.rows).map(([label]) => <li>{label}</li>)}</ul>
            </div>
          )}

          {id === 'models' && (
            <div class="caps-window">
              <p class="caps-window-title">{f.models.title}</p>
              {picks.map((model, index) => (
                <div class="caps-row caps-model">
                  <span class="caps-model-name"><b>{model.name}</b><span>{model.engine}</span></span>
                  <ul class="pill-list">
                    <li>{model.languages.join(', ')}</li>
                    {model.streaming && <li>{t.models.streaming}</li>}
                    <li>{model.size}</li>
                  </ul>
                  {index === picks.length - 1 && <span class="caps-progress"><i></i></span>}
                </div>
              ))}
            </div>
          )}

          {id === 'profile' && (
            <div class="caps-window">
              <p class="caps-window-title">{f.profile.name}</p>
              <ul class="pill-list">{llmProviders.map((provider) => <li class={provider === 'Ollama' ? 'is-on' : undefined}>{provider}</li>)}</ul>
              <p class="caps-row mono">{f.profile.address} · {f.profile.model}</p>
              <p class="caps-row caps-prompt">{f.profile.prompt}</p>
            </div>
          )}

          {id === 'history' && (
            <div class="caps-window">
              <p class="caps-window-title">{f.history.title}</p>
              {f.history.entries.map(([entry, time]) => <p class="caps-row caps-entry"><span>{entry}</span><time>{time}</time></p>)}
            </div>
          )}

          {id === 'file' && (
            <div class="caps-window">
              <p class="caps-window-title">{f.file.title}</p>
              <p class="caps-row caps-entry"><b>{f.file.name}</b><span class="caps-done">{f.file.done}</span></p>
              <p class="caps-row">{f.file.result}</p>
              <p class="caps-note">{audioExtensions.join(', ')} · {f.file.note}</p>
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
