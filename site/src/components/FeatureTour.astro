---
import Icon from './Icon.astro';
import TourOverlay from './TourOverlay.astro';
import TourScreen from './TourScreen.astro';
import { audioExtensions, featureSteps } from '../data/feature-tour';
import { llmProviders } from '../data/product';
import { format } from '../i18n';
import { translationsFor } from '../i18n/context';

const { t } = translationsFor(Astro.currentLocale);
const f = t.features;
const total = featureSteps.length;
const pad = (value: number) => String(value).padStart(2, '0');
const sample = f.cleanup.sample.map((part) => (typeof part === 'string' ? { from: part, to: part } : { from: part[0], to: part[1], kind: part[2] }));
const cleanupRows = Object.entries(f.cleanup.rows) as [keyof typeof f.cleanup.rows, [string, string]][];
const p = f.profile;
---

<section id="features" class="section container" data-screen-label="02 Features">
  <div class="section-head" data-reveal>
    <p class="section-label">{f.eyebrow}</p>
    <h2 class="section-title">{f.title}</h2>
  </div>

  {/* The scenes are complete without scripts: each is a heading, its text and a
      still picture. The step list only switches between them, so it waits for JS. */}
  <div class="tour" data-tour data-reveal="80">
    <div class="tour-steps js-only" role="tablist" aria-label={f.stepsLabel} aria-orientation="vertical">
      {featureSteps.map((id, index) => (
        <button type="button" role="tab" id={`feature-tab-${id}`} aria-controls={`feature-${id}`}
          aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? undefined : '-1'}>
          <span class="tour-step-number">{pad(index + 1)}</span>{f.steps[id].name}
        </button>
      ))}
    </div>

    <div class="tour-scenes">
      {featureSteps.map((id, index) => (
        <article class="card tour-scene" id={`feature-${id}`} role="tabpanel" aria-labelledby={`feature-tab-${id}`}
          data-scene={id} {...(id === 'overlay' ? { 'data-template': 'pill', 'data-phase': 'stream' } : {})}
          {...(id === 'file' ? { 'data-state': 'done' } : {})}>
          <header class="tour-scene-head">
            <div>
              <h3>{f.steps[id].title}</h3>
              <p>{f.steps[id].text}</p>
            </div>
            <span class="tour-count">{format(f.stepCount, { n: pad(index + 1), total: pad(total) })}</span>
          </header>
          <div class="tour-scene-body">
            {id === 'catalog' && <TourScreen screen="models" scene={f.catalog} />}
            {id === 'history' && <TourScreen screen="history" scene={f.history} />}
            {id === 'overlay' && <TourOverlay />}

            {id === 'cleanup' && (
              <Fragment>
                <div class="tour-stage cleanup">
                  <div class="cleanup-line">
                    <span class="cleanup-label">{f.cleanup.beforeLabel}</span>
                    <p>{sample.map((part) => (part.kind && part.from ? <span class={`cl cl-${part.kind}`}>{part.from}</span> : part.from))}</p>
                  </div>
                  <div class="cleanup-line cleanup-after">
                    <span class="cleanup-label">{f.cleanup.afterLabel}</span>
                    <p>{sample.map((part) => (part.kind && part.to ? <span class={`cl cl-${part.kind}`}>{part.to}</span> : part.to))}</p>
                  </div>
                </div>
                <ul class="tour-details">
                  {cleanupRows.map(([kind, [label, value]]) => (
                    <li class="tour-detail"><span><span class={`cl-key cl-${kind}`} aria-hidden="true">Aa</span>{label}</span><span class="tour-detail-value">{value}</span></li>
                  ))}
                </ul>
              </Fragment>
            )}

            {id === 'profile' && (
              <Fragment>
                <dl class="tour-stage profile">
                  <div class="profile-field"><dt>{p.fields.name}</dt><dd>{p.name}</dd></div>
                  <div class="profile-field">
                    <dt>{p.fields.provider}</dt>
                    <dd><ul class="profile-providers">{llmProviders.map((provider) => <li class={provider === 'Ollama' ? 'is-on' : undefined}>{provider}</li>)}</ul></dd>
                  </div>
                  <div class="profile-pair">
                    <div class="profile-field"><dt>{p.fields.model}</dt><dd class="mono">{p.model}</dd></div>
                    <div class="profile-field"><dt>{p.fields.address}</dt><dd class="mono">{p.address}</dd></div>
                  </div>
                  <div class="profile-field"><dt>{p.fields.prompt}</dt><dd class="profile-prompt">{p.prompt}</dd></div>
                </dl>
                <ul class="tour-details">
                  {p.rows.map(([label, value]) => <li class="tour-detail"><span>{label}</span><span class="tour-detail-value">{value}</span></li>)}
                </ul>
              </Fragment>
            )}

            {id === 'file' && (
              <Fragment>
                <div class="tour-stage file" data-file aria-hidden="true">
                  <div class="file-drop">
                    <span class="file-mark"><Icon name="mic" size={16} /></span>
                    <div class="file-copy">
                      <strong>
                        <span class="file-idle">{f.file.title} <span class="file-note">{f.file.dragNote}</span></span>
                        <span class="file-reading">{f.file.reading}</span>
                        <span class="file-transcribing">{f.file.transcribing}</span>
                      </strong>
                      <span class="file-idle">{audioExtensions.join(', ')}</span>
                      <span class="file-busy">{f.file.local}</span>
                    </div>
                    <span class="file-button file-idle"><Icon name="folder" size={12} />{f.file.pick}</span>
                    <span class="file-button file-busy">{f.file.cancel}</span>
                  </div>
                  <div class="file-result">
                    <span>{f.file.name}</span>
                    <p>{f.file.result}</p>
                  </div>
                </div>
                <ul class="tour-details">
                  {f.file.rows.map(([label, value]) => <li class="tour-detail"><span>{label}</span><span class="tour-detail-value">{value}</span></li>)}
                </ul>
              </Fragment>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
