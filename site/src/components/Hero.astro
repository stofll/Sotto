---
import DesktopDemo from './DesktopDemo.astro';
import { LINKS } from '../data/product';
import { latestRelease } from '../data/release';
import { format } from '../i18n';
import { translationsFor } from '../i18n/context';

const { t } = translationsFor(Astro.currentLocale);
const release = await latestRelease();
const meta = release
  ? `${t.hero.meta}. ${format(t.hero.version, { version: release.version.replace(/^v/, '') })}`
  : t.hero.meta;
---

<section class="hero container" data-screen-label="01 Hero">
  <p class="hero-eyebrow">{t.hero.eyebrow}</p>
  <h1 class="hero-title">{t.hero.titleLine1}<br /><span>{t.hero.titleLine2}</span></h1>
  <div class="hero-foot">
    <p class="hero-subtitle">{t.hero.subtitle}</p>
    <div class="hero-actions">
      <div class="hero-buttons">
        {/* Leads to both platforms until scripts/platform.ts recognises the
            reader's system and points it at that installer. */}
        <a class="button button-primary" href="#start" data-platform-cta="long">{t.hero.download}</a>
        <a class="button button-outline" href={LINKS.github}>GitHub ↗</a>
      </div>
      <span class="hero-meta">{meta}</span>
      <span class="hero-meta hero-note" data-mobile-note>{t.hero.mobileNote}</span>
    </div>
  </div>
</section>

<DesktopDemo />
