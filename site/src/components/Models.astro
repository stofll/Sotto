---
import { LINKS, models } from '../data/product';
import { format } from '../i18n';
import { translationsFor } from '../i18n/context';

const { t } = translationsFor(Astro.currentLocale);
const m = t.models;
const total = models.length;
const filters = Object.entries(m.filters) as [keyof typeof m.filters, string][];
const featured = ['GigaAM v3', 'Nemotron 3.5', 'Parakeet TDT v3', 'Whisper turbo'].map((name) => models.find((model) => model.name === name)!);
---

<section id="models" class="section container" data-screen-label="04 Models">
  <div class="section-head" data-reveal>
    <p class="section-label">{m.eyebrow}</p>
    <h2 class="section-title">{m.title}</h2>
    <p class="section-lede">{m.description}</p>
  </div>

  <ul class="model-featured">
    {featured.map((model, index) => (
      <li class="model-pick">
        <p class="model-purpose">{m.purposes[index]}</p>
        <h3>{model.name}</h3>
        <p class="model-pick-meta">{model.size} <span aria-hidden="true">·</span> {model.languages.join(', ')}</p>
      </li>
    ))}
  </ul>

  <details class="model-catalog">
  <summary>{format(m.allModels, { total })}</summary>
  {/* The filters narrow a list that is complete without them, so they appear
      only once the script is there to drive them. */}
  <div class="model-toolbar js-only" data-model-filters>
    <div class="model-chips" role="group" aria-label={m.filterLabel}>
      {filters.map(([id, label], index) => (
        <button type="button" class="chip" data-filter={id} aria-pressed={index === 0 ? 'true' : 'false'}>{label}</button>
      ))}
      <button type="button" class="chip chip-dashed" data-streaming-filter aria-pressed="false">
        {m.streamingOnly}
      </button>
    </div>
    <span class="model-count mono" role="status" data-model-count>{format(m.count, { shown: total, total })}</span>
  </div>

  <ul class="model-grid">
    {models.map((model) => (
      <li
        class="card model-card"
        data-groups={model.groups.join(' ')}
        data-streaming={model.streaming ? '' : undefined}
      >
        <div class="model-card-head">
          <div class="model-name">
            <strong>{model.name}</strong>
            <span class="mono">{model.engine}</span>
          </div>
          <span class="model-size mono">{model.size}</span>
        </div>
        <div class="model-tags mono">
          {model.languages.map((language) => <span class="tag">{language}</span>)}
          {model.streaming && <span class="tag tag-outline">{m.streaming}</span>}
          {model.punctuation && <span class="tag tag-outline">{m.punctuation}</span>}
        </div>
      </li>
    ))}
  </ul>
  <p class="model-empty mono" data-model-empty hidden>{m.empty}</p>
  <span class="section-note">{m.note} <a href={LINKS.models}>models.md ↗</a></span>
  </details>
</section>
