{
  "extends": "../../desktop/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../../desktop",
    "paths": {
      "react": ["node_modules/@types/react"],
      "react/*": ["node_modules/@types/react/*"],
      "react-dom/*": ["node_modules/@types/react-dom/*"],
      "@tauri-apps/api/*": ["node_modules/@tauri-apps/api/*"]
    },
    "types": ["vite/client"],
    "typeRoots": ["../../desktop/node_modules/@types", "../../desktop/node_modules"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src.tsx"]
}
